# Aplicação
PORT=3002
NODE_ENV=development

# JWT (verificação stateless — mesmo segredo do os-service)
JWT_SECRET=troque-por-um-segredo-forte-em-producao

# MongoDB (exclusivo deste serviço: pagamentos)
MONGODB_URI=mongodb://localhost:27017/oficina_pagamento

# Mercado Pago — NUNCA commitar o token real. Em produção vem de GitHub
# Secrets; em dev local, use as credenciais de TESTE da sua conta Mercado
# Pago (https://www.mercadopago.com.br/developers/panel/app).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_NOTIFICATION_URL=http://localhost:3002/pagamentos/webhook

# Observabilidade (New Relic, mesma conta da Fase 3) — desligado por padrão em dev local/CI.
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=oficina-pagamento-service
