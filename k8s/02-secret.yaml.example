# TEMPLATE — copie para 02-secret.yaml, preencha com valores reais e NUNCA
# commite o arquivo preenchido (02-secret.yaml está no .gitignore).
#
# Alternativa recomendada (sem deixar o segredo em disco):
#   kubectl create secret generic oficina-pagamento-app-secret -n oficina-pagamento \
#     --from-literal=JWT_SECRET='<segredo-forte>' \
#     --from-literal=MERCADOPAGO_ACCESS_TOKEN='<token-de-teste-do-mercado-pago>'
apiVersion: v1
kind: Secret
metadata:
  name: oficina-pagamento-app-secret
  namespace: oficina-pagamento
type: Opaque
stringData:
  JWT_SECRET: 'troque-por-um-segredo-forte-em-producao'
  MERCADOPAGO_ACCESS_TOKEN: ''
